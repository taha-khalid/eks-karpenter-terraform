Core Terraform Code Snippets
1. Base Cluster & Karpenter IAM Setup (main.tf)
Uses community-vetted base modules extended with custom security constraints.  
Terraform Registry

Terraform
module "eks" {
  source  = "terraform-aws-modules/eks/aws"
  version = "~> 20.0"

  cluster_name                    = "prod-infra-cluster"
  cluster_version                 = "1.30"
  cluster_endpoint_private_access = true
  cluster_endpoint_public_access  = false # Enforce Zero-Trust Network

  vpc_id     = module.vpc.vpc_id
  subnet_ids = module.vpc.private_subnets

  # Enable Envelope Encryption for Secrets using KMS
  create_kms_key = true
  cluster_encryption_config = {
    resources = ["secrets"]
  }

  # Fixed System Node Group for Control System Components & Karpenter
  eks_managed_node_groups = {
    karpenter_system = {
      instance_types = ["m6i.large"]
      min_size       = 2
      max_size       = 3
      desired_size   = 2

      labels = {
        "workload.type" = "system"
      }
      taints = [{
        key    = "CriticalAddonsOnly"
        value  = "true"
        effect = "NO_SCHEDULE"
      }]
    }
  }
}

# IAM Role for Karpenter Controller via Pod Identity
module "karpenter" {
  source  = "terraform-aws-modules/eks/aws//modules/karpenter"
  version = "~> 20.0"

  cluster_name = module.eks.cluster_name

  enable_pod_identity             = true
  create_pod_identity_association = true

  # Attach Node IAM Role permissions created by Karpenter
  node_iam_role_additional_policies = {
    AmazonSSMManagedInstanceCore = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
  }
}
2. Declarative Karpenter CRDs via Terraform (karpenter_resources.tf)
Deploying production EC2NodeClass and NodePool directly in HCL via kubectl or helm.  
OneUptime

Terraform
# 1. Define AWS Node Specs (Bottlerocket, Security, Network)
resource "kubectl_manifest" "karpenter_node_class" {
  yaml_body = <<YAML
apiVersion: karpenter.k8s.aws/v1
kind: EC2NodeClass
metadata:
  name: security-hardened
spec:
  amiSelectorTerms:
    - alias: bottlerocket@latest
  role: ${module.karpenter.node_iam_role_name}
  subnetSelectorTerms:
    - tags:
        karpenter.sh/discovery: ${module.eks.cluster_name}
  securityGroupSelectorTerms:
    - tags:
        karpenter.sh/discovery: ${module.eks.cluster_name}
  metadataOptions:
    httpEndpoint: enabled
    httpProtocolIPv6: disabled
    httpPutResponseHopLimit: 1
    httpTokens: required  # Enforce IMDSv2
  blockDeviceMappings:
    - deviceName: /dev/xvda
      ebs:
        volumeSize: 20Gi
        volumeType: gp3
        encrypted: true
YAML

  depends_on = [module.eks]
}

# 2. Define Workload Autoscaling Policy with Consolidation
resource "kubectl_manifest" "karpenter_nodepool_stateless" {
  yaml_body = <<YAML
apiVersion: karpenter.sh/v1
kind: NodePool
metadata:
  name: stateless-apps
spec:
  template:
    spec:
      nodeClassRef:
        group: karpenter.k8s.aws
        kind: EC2NodeClass
        name: security-hardened
      requirements:
        - key: karpenter.sh/capacity-type
          operator: In
          values: ["spot", "on-demand"]
        - key: kubernetes.io/arch
          operator: In
          values: ["amd64", "arm64"]
        - key: karpenter.k8s.aws/instance-category
          operator: In
          values: ["c", "m", "r"]
  disruption:
    consolidationPolicy: WhenUnderutilized
    consolidateAfter: 30s
  limits:
    cpu: "1000"
    memory: 2000Gi
YAML

  depends_on = [kubectl_manifest.karpenter_node_class]
}
Advanced Engineering Proof-Points
Self-Healing Deprovisioning: Configure an SQS event rule triggered by AWS Health Dashboard/EC2 rebalance notifications fed to Karpenter, allowing pre-emptive graceful node draining 2 minutes before Spot termination.  
Terraform Registry

Kube-Bench / CIS Compliance: Bottlerocket nodes integrated with automated Falco runtime security enforcement deployed via DaemonSets.

Topology Spread Constraints: Application manifests specify Pod Anti-Affinity and topologySpreadConstraints over topology.kubernetes.io/zone, allowing Karpenter to compute multi-AZ instance distribution automatically without manual subnet definitions.

