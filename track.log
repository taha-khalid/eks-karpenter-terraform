main.tf
Terraform
data "aws_availability_zones" "available" {
  state = "available"
}

# ------------------------------------------------------------------------------
# 1. VPC NETWORKING (Private-First Topology)
# ------------------------------------------------------------------------------
module "vpc" {
  source  = "terraform-aws-modules/vpc/aws"
  version = "~> 5.5"

  name = "${var.cluster_name}-vpc"
  cidr = var.vpc_cidr

  azs             = slice(data.aws_availability_zones.available.names, 0, 3)
  private_subnets = [for k, v in slice(data.aws_availability_zones.available.names, 0, 3) : cidrsubnet(var.vpc_cidr, 4, k)]
  public_subnets  = [for k, v in slice(data.aws_availability_zones.available.names, 0, 3) : cidrsubnet(var.vpc_cidr, 8, k + 48)]

  enable_nat_gateway   = true
  single_nat_gateway   = false # Highly available across AZs
  enable_dns_hostnames = true
  enable_dns_support   = true

  # Karpenter & ALB Auto-Discovery Subnet Tags
  private_subnet_tags = {
    "karpenter.sh/discovery"                  = var.cluster_name
    "kubernetes.io/role/internal-elb"         = "1"
    "kubernetes.io/cluster/${var.cluster_name}" = "owned"
  }
}

# ------------------------------------------------------------------------------
# 2. EKS CONTROL PLANE & SYSTEM NODE GROUP
# ------------------------------------------------------------------------------
module "eks" {
  source  = "terraform-aws-modules/eks/aws"
  version = "~> 20.0"

  cluster_name                   = var.cluster_name
  cluster_version                = "1.30"
  cluster_endpoint_private_access = true
  cluster_endpoint_public_access  = false # Enforce Zero-Trust Network access

  vpc_id     = module.vpc.vpc_id
  subnet_ids = module.vpc.private_subnets

  # KMS Envelope Encryption for Secrets
  create_kms_key = true
  cluster_encryption_config = {
    resources = ["secrets"]
  }

  # Enable Pod Identity authentication engine
  enable_cluster_creator_admin_permissions = true

  # Dedicated System Node Group for System Pods and Karpenter Controller
  eks_managed_node_groups = {
    system_nodes = {
      name           = "system-addons"
      instance_types = ["m6i.large"]
      min_size       = 2
      max_size       = 3
      desired_size   = 2

      subnet_ids = module.vpc.private_subnets

      labels = {
        "workload.type" = "system"
      }

      taints = [{
        key    = "CriticalAddonsOnly"
        value  = "true"
        effect = "NO_SCHEDULE"
      }]

      # Security Hardening: Enforce IMDSv2 on System Nodes
      metadata_options = {
        http_endpoint               = "enabled"
        http_tokens                 = "required"
        http_put_response_hop_limit = 1
      }
    }
  }

  # Cluster Security Group Discovery Tagging for Karpenter
  node_security_group_tags = {
    "karpenter.sh/discovery" = var.cluster_name
  }
}

# ------------------------------------------------------------------------------
# 3. KARPENTER IAM & SQS INTERRUPTION INFRASTRUCTURE
# ------------------------------------------------------------------------------
module "karpenter" {
  source  = "terraform-aws-modules/eks/aws//modules/karpenter"
  version = "~> 20.0"

  cluster_name = module.eks.cluster_name

  # Enable native EKS Pod Identity Association
  enable_pod_identity             = true
  create_pod_identity_association = true

  # Attach standard SSM Policy to nodes launched by Karpenter for management
  node_iam_role_additional_policies = {
    AmazonSSMManagedInstanceCore = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
  }

  # Automatically provisions SQS queue & EventBridge rules for Spot Interruption notifications
  enable_spot_termination = true
}

# ------------------------------------------------------------------------------
# 4. HELM DEPLOYMENTS (Karpenter & System Workloads)
# ------------------------------------------------------------------------------

# Helm Release for Karpenter Controller
resource "helm_release" "karpenter" {
  namespace        = "kube-system"
  name             = "karpenter"
  repository       = "oci://public.ecr.aws/karpenter"
  chart            = "karpenter"
  version          = var.karpenter_version
  create_namespace = false

  values = [
    <<YAML
settings:
  clusterName: ${module.eks.cluster_name}
  clusterEndpoint: ${module.eks.cluster_endpoint}
  interruptionQueue: ${module.karpenter.queue_name}
tolerations:
  - key: "CriticalAddonsOnly"
    operator: "Exists"
    effect: "NoSchedule"
nodeSelector:
  workload.type: "system"
YAML
  ]

  depends_on = [module.eks, module.karpenter]
}

# ------------------------------------------------------------------------------
# 5. KARPENTER CRD MANIFEST APPLIES (v1 API Standard)
# ------------------------------------------------------------------------------
resource "kubectl_manifest" "karpenter_ec2_node_class" {
  yaml_body = templatefile("${path.module}/manifests/ec2nodeclass.yaml", {
    cluster_name   = module.eks.cluster_name
    node_role_name = module.karpenter.node_iam_role_name
  })

  depends_on = [helm_release.karpenter]
}

resource "kubectl_manifest" "karpenter_node_pool" {
  yaml_body = file("${path.module}/manifests/nodepool-stateless.yaml")

  depends_on = [kubectl_manifest.karpenter_ec2_node_class]
}
Manifest Files
manifests/ec2nodeclass.yaml
YAML
apiVersion: karpenter.k8s.aws/v1
kind: EC2NodeClass
metadata:
  name: security-hardened
spec:
  amiFamily: Bottlerocket
  amiSelectorTerms:
    - alias: bottlerocket@latest
  role: ${node_role_name}
  subnetSelectorTerms:
    - tags:
        karpenter.sh/discovery: ${cluster_name}
  securityGroupSelectorTerms:
    - tags:
        karpenter.sh/discovery: ${cluster_name}
  metadataOptions:
    httpEndpoint: enabled
    httpProtocolIPv6: disabled
    httpPutResponseHopLimit: 1
    httpTokens: required  # Enforces IMDSv2
  blockDeviceMappings:
    - deviceName: /dev/xvda
      ebs:
        volumeSize: 20Gi
        volumeType: gp3
        encrypted: true
manifests/nodepool-stateless.yaml
YAML
apiVersion: karpenter.sh/v1
kind: NodePool
metadata:
  name: stateless-apps
spec:
  template:
    spec:
      nodeClassRef:
        group: karpenter.k8s.aws
        kind: EC2NodeClass
        name: security-hardened
      requirements:
        - key: karpenter.sh/capacity-type
          operator: In
          values: ["spot", "on-demand"]
        - key: kubernetes.io/arch
          operator: In
          values: ["amd64", "arm64"]
        - key: karpenter.k8s.aws/instance-category
          operator: In
          values: ["c", "m", "r"]
  disruption:
    consolidationPolicy: WhenUnderutilized
    consolidateAfter: 30s
    budgets:
      - nodes: "10%" # Max 10% of nodes disrupted simultaneously
  limits:
    cpu: "1000"
    memory: 2000Gi
